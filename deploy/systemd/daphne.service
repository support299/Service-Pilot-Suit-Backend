# Daphne unit for Community WebSockets (optional alongside gunicorn for HTTP).
# Install: sudo cp deploy/systemd/daphne.service /etc/systemd/system/
#          sudo systemctl enable --now daphne
#
# Prefer terminating TLS at nginx and proxying:
#   location /ws/ { proxy_pass http://127.0.0.1:8001; proxy_http_version 1.1;
#                   proxy_set_header Upgrade $http_upgrade;
#                   proxy_set_header Connection "upgrade"; ... }
#
# Local/dev: daphne -b 0.0.0.0 -p 8000 config.asgi:application

[Unit]
Description=Daphne ASGI (Service Pilot Suite — Community WebSockets)
After=network.target redis-server.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/backend/Service-Pilot-Suit-Backend
Environment=PATH=/home/ubuntu/backend/Service-Pilot-Suit-Backend/venv/bin
ExecStart=/home/ubuntu/backend/Service-Pilot-Suit-Backend/venv/bin/daphne \
          -b 127.0.0.1 -p 8001 \
          config.asgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
